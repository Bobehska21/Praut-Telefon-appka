# Copy to .env and fill in. .env is git-ignored and Claude can neither read nor write it.
# Every variable the app reads must be listed here with a placeholder.

# Local development database (read-write)
DATABASE_URL=postgresql://app:changeme@localhost:5432/app

# Read-only role used by the postgres MCP server (see docs/prod-readonly.md)
DATABASE_URL_RO=postgresql://claude_ro:changeme@localhost:5432/app

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# --- server/ (multiplayer backend) ---
# Required. Postgres connection string of the backend (local dev DB from server/docker-compose.yml: localhost:5433).
# (Reuses DATABASE_URL above; point it at the server database.)
# Required, >= 32 characters. Protects /admin/*. Generate with: openssl rand -base64 32
ADMIN_TOKEN=changeme-generate-a-long-random-string
HOST=0.0.0.0
# Pool size per process: replicas x DB_POOL_MAX must stay below the database connection limit.
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
# Timezone that defines the day of GET /v1/leaderboard (IANA name).
LEADERBOARD_TZ=Europe/Prague
# Local-disk photo storage (development only; use object storage with more than one replica).
PHOTO_DIR=./data/photos
# true when running behind a trusted proxy / ingress (rate limits use the client IP).
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=20000
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_CHALLENGE_PER_MIN=20
RATE_LIMIT_REPORT_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_MIN=10
# DEV ONLY. true enables POST /v1/dev/focus-minutes (grants focus minutes, to skip the 90-minute kill gate in
# two-phone tests). The server refuses to start with true when NODE_ENV=production.
DEV_FAKE_MINUTES=false
# scrypt cost exponent (N = 2^value) for new password hashes, 10-18.
PASSWORD_SCRYPT_LOG2N=15
# Test database (server tests create an isolated schema per test file in it).
TEST_DATABASE_URL=postgresql://focus:changeme@localhost:5433/focus_dev
# Password for the local docker-compose database.
FOCUS_PG_PASSWORD=changeme
