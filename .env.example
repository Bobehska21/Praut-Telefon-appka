# Copy to .env and fill in. .env is git-ignored and Claude can neither read nor write it.
# Every variable the app reads must be listed here with a placeholder.

# Local development database (read-write)
DATABASE_URL=postgresql://app:changeme@localhost:5432/app

# Read-only role used by the postgres MCP server (see docs/prod-readonly.md)
DATABASE_URL_RO=postgresql://claude_ro:changeme@localhost:5432/app

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
